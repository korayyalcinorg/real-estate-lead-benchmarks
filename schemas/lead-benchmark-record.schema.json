{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/korayyalcinorg/real-estate-lead-benchmarks/schemas/lead-benchmark-record.schema.json",
  "title": "Real Estate Lead Benchmark Record",
  "type": "object",
  "required": [
    "lead_id",
    "lead_created_at",
    "source",
    "contacted",
    "qualified",
    "appointment_scheduled",
    "appointment_completed",
    "won",
    "lost"
  ],
  "properties": {
    "lead_id": {"type": "string"},
    "lead_created_at": {"type": "string", "format": "date-time"},
    "first_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "first_contacted_at": {"type": ["string", "null"], "format": "date-time"},
    "qualified_at": {"type": ["string", "null"], "format": "date-time"},
    "appointment_created_at": {"type": ["string", "null"], "format": "date-time"},
    "appointment_completed_at": {"type": ["string", "null"], "format": "date-time"},
    "won_at": {"type": ["string", "null"], "format": "date-time"},
    "lost_at": {"type": ["string", "null"], "format": "date-time"},
    "source": {"type": "string"},
    "campaign": {"type": ["string", "null"]},
    "project": {"type": ["string", "null"]},
    "market": {"type": ["string", "null"]},
    "language": {"type": ["string", "null"]},
    "sales_rep": {"type": ["string", "null"]},
    "contacted": {"type": "boolean"},
    "qualified": {"type": "boolean"},
    "appointment_scheduled": {"type": "boolean"},
    "appointment_completed": {"type": "boolean"},
    "won": {"type": "boolean"},
    "lost": {"type": "boolean"},
    "lost_reason": {"type": ["string", "null"]},
    "lead_score": {"type": ["number", "null"], "minimum": 0},
    "media_spend_allocated": {"type": ["number", "null"], "minimum": 0}
  },
  "additionalProperties": true
}
